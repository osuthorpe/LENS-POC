{
  "name": "aivc-company-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "data:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-data.ts",
    "setup": "npm run db:up && npm run db:migrate && npm run data:import",
    "test": "vitest run",
    "verify:embeddings": "node --env-file-if-exists=.env.local --import tsx scripts/verify-embeddings.ts",
    "verify:v1": "node --env-file-if-exists=.env.local --import tsx scripts/verify-v1.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.38.0",
    "next": "^16.3.3",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
